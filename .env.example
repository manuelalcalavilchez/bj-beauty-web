# ============================================================
# .env.example — variables de entorno de BJ Beauty
# Copiar a .env y rellenar los valores entre comillas.
# ============================================================

# --- Correo saliente (SMTP) — para enviar confirmaciones de citas ---
# Servidor: authsmtp.securemail.pro | Puerto 465 | SSL/TLS
SMTP_HOST=authsmtp.securemail.pro
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="tu-correo@tu-dominio.es"
SMTP_PASS="tu-contrase-a-de-aplicacion"
SMTP_FROM="BJ Beauty <tu-correo@tu-dominio.es>"
SALON_NOTIFICATION_EMAIL=tu-correo@tu-dominio.es

# --- Correo entrante (POP/IMAP) — solo lectura de la bandeja. ---
# No está conectado al flujo de envíos de esta app.
# Servidor: pop.securemail.pro | Puerto 995 (POP) | SSL/TLS | sin SPA.
# ============================================================

# Cabina Staff (panel de administración)
# PIN para entrar al panel. Si queda vacío, Staff queda deshabilitado.
# Genera una clave local con: openssl rand -hex 32
STAFF_PIN="000000"
STAFF_SESSION_SECRET="MY_LONG_RANDOM_SECRET"
STAFF_SESSION_HOURS=12
TRUST_PROXY="loopback, linklocal, uniquelocal"

# Feed público (Instagram-autopilot / servicios externos)
CONTENT_FEED_API_KEY="MY_CONTENT_FEED_API_KEY"

# --- NOTA ---
# Las claves de Gemini no son necesarias para este proyecto.
